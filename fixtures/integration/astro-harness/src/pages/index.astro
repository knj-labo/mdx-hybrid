---
import { docs } from 'virtual:markflow-docs'
import {
  Content as GettingStartedContent,
  frontmatter as gettingStartedMeta,
} from '../content/docs/getting-started.mdx'
import {
  Content as DirectivesContent,
  frontmatter as directivesMeta,
} from '../../content/docs/directives.mdx'
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Markflow Astro Harness</title>
  </head>
  <body>
    <main>
      <h1>Harness Docs ({docs.length})</h1>
      {docs
        .slice()
        .sort((a, b) => a.slug.localeCompare(b.slug))
        .map((doc) => (
          <article>
            <header>
              <h2>{doc.title}</h2>
              <p class="doc-meta">
                <code>{doc.slug}</code>
                {doc.description && <span>{doc.description}</span>}
              </p>
            </header>
            <div set:html={doc.html} />
          </article>
        ))}
      <section class="mdx-preview">
        <header>
          <h2>{gettingStartedMeta.title}</h2>
          <p>{gettingStartedMeta.description}</p>
        </header>
        <GettingStartedContent />
      </section>
      <section class="mdx-preview">
        <header>
          <h2>{directivesMeta.title}</h2>
        </header>
        <DirectivesContent />
      </section>
    </main>
    <footer>
      <p>MDX above is rendered via the Markflow Vite plugin.</p>
    </footer>
  </body>
</html>
