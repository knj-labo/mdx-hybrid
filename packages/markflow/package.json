{
  "name": "markflow",
  "version": "0.0.1",
  "description": "High-performance streaming Markdown to HTML parser built with Rust",
  "type": "module",
  "exports": {
    ".": {
      "node": "./src/node.js",
      "browser": "./src/browser.js",
      "edge-light": "./src/browser.js",
      "workerd": "./src/browser.js",
      "default": "./src/browser.js"
    },
    "./browser": {
      "types": "./src/index.d.ts",
      "import": "./src/browser.js",
      "default": "./src/browser.js"
    },
    "./registry": {
      "types": "./src/registry/types.d.ts",
      "import": "./src/registry/index.js",
      "default": "./src/registry/index.js"
    },
    "./wasm": {
      "types": "./wasm/markflow_wasm.d.ts",
      "import": "./wasm/markflow_wasm.js",
      "default": "./wasm/markflow_wasm.js"
    }
  },
  "main": "./src/node.js",
  "types": "./src/index.d.ts",
  "files": [
    "src",
    "wasm"
  ],
  "keywords": [
    "markdown",
    "parser",
    "rust",
    "streaming",
    "performance",
    "html",
    "wasm",
    "mdx"
  ],
  "author": "jp-knj",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/knj-labo/markflow"
  },
  "dependencies": {
    "markflow-napi": "workspace:*"
  }
}
